{
  "name": "alexa-composer-quiz",
  "version": "1.0.0",
  "private": true,
  "description": "Alexa skill: a guess-the-composer party game for up to four players.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:model": "node scripts/build-model.mjs",
    "build:clips": "node scripts/build-clips.mjs",
    "check": "node scripts/build-model.mjs --check && npm test",
    "alexa": "node scripts/alexa.mjs",
    "alexa:test": "node scripts/alexa.mjs dialog de-DE --file test/dialogs/de-DE.txt"
  }
}
